      "name": "CapecExternalReference",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecExternalReference",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ExternalReferenceType",
          "@type": "Annotation"
        }
      ],
      "description": "A publication or page outside CAPEC that entries point to for more detail.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "close_mappings": [
        "stix:StixExternalReference",
        "sepses_capec:Reference",
        "cwe:CweExternalReference"
      ],
      "slots": [
        "capecExternalReference__Reference_ID",
        "capecExternalReference__Author",
        "capecExternalReference__Title",
        "capecExternalReference__Edition",
        "capecExternalReference__Publication",
        "capecExternalReference__Publication_Year",
        "capecExternalReference__Publication_Month",
        "capecExternalReference__Publication_Day",
        "capecExternalReference__Publisher",
        "capecExternalReference__URL",
        "capecExternalReference__URL_Date"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Reference_ID",
          "description": "The identifier entries use to cite this reference.",
          "broad_mappings": [
            "dcterms:identifier"
          ],
          "identifier": true,
          "range": "capec_reference_id",
          "@type": "SlotDefinition"
        },
        {
          "name": "Author",
          "description": "A person or body who wrote the work.",
          "close_mappings": [
            "dcterms:creator",
            "sepses_capec:referenceAuthor"
          ],
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Title",
          "description": "The work's title.",
          "close_mappings": [
            "dcterms:title",
            "sepses_capec:referenceTitle"
          ],
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Edition",
          "description": "Which edition of the work is meant.",
          "close_mappings": [
            "schema:bookEdition"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "Publication",
          "description": "The journal, conference or larger work that holds it.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Publication_Year",
          "description": "The year it appeared.",
          "close_mappings": [
            "sepses_capec:referencePublicationYear"
          ],
          "range": "capec_year",
          "@type": "SlotDefinition"
        },
        {
          "name": "Publication_Month",
          "description": "The month it appeared.",
          "close_mappings": [
            "sepses_capec:referencePublicationMonth"
          ],
          "range": "capec_month",
          "@type": "SlotDefinition"
        },
        {
          "name": "Publication_Day",
          "description": "The day of the month it appeared.",
          "close_mappings": [
            "sepses_capec:referencePublicationDay"
          ],
          "range": "capec_day",
          "@type": "SlotDefinition"
        },
        {
          "name": "Publisher",
          "description": "Who published it.",
          "close_mappings": [
            "dcterms:publisher",
            "sepses_capec:referencePublisher"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "URL",
          "description": "Where it can be read.",
          "close_mappings": [
            "schema:url",
            "sepses_capec:referenceUrl"
          ],
          "range": "capec_uri",
          "@type": "SlotDefinition"
        },
        {
          "name": "URL_Date",
          "description": "The day someone last confirmed the address worked.",
          "range": "date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecExternalReference",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecReference",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecReference",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ReferencesType/Reference",
          "@type": "Annotation"
        }
      ],
      "description": "One citation by an entry of an external reference.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "slots": [
        "capecReference__External_Reference_ID",
        "capecReference__Section"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "External_Reference_ID",
          "description": "The reference cited.",
          "range": "CapecExternalReference",
          "required": true,
          "pattern": "^REF-[0-9]+$",
          "@type": "SlotDefinition"
        },
        {
          "name": "Section",
          "description": "The section title or page that this citation means.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecReference",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecNote",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecNote",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "NotesType/Note",
          "@type": "Annotation"
        }
      ],
      "description": "A remark on an entry that no other field can hold.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "close_mappings": [
        "skos:note"
      ],
      "slots": [
        "capecNote__Type",
        "capecNote__Value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Type",
          "description": "What kind of remark it is.",
          "range": "CapecNoteType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Value",
          "description": "The remark itself.",
          "range": "capec_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecNote",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecTaxonomyMapping",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecTaxonomyMapping",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "TaxonomyMappingsType/Taxonomy_Mapping",
          "@type": "Annotation"
        }
      ],
      "description": "A link from an entry to the matching entry of another taxonomy.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "close_mappings": [
        "skos:mappingRelation"
      ],
      "slots": [
        "capecTaxonomyMapping__Taxonomy_Name",
        "capecTaxonomyMapping__Entry_ID",
        "capecTaxonomyMapping__Entry_Name",
        "capecTaxonomyMapping__Mapping_Fit"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Taxonomy_Name",
          "description": "The other taxonomy.",
          "range": "CapecTaxonomyName",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Entry_ID",
          "description": "The other entry's identifier in that taxonomy.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Entry_Name",
          "description": "The other entry's name in that taxonomy.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Mapping_Fit",
          "description": "How well the two entries fit.",
          "range": "CapecTaxonomyMappingFit",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecTaxonomyMapping",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecExcludeRelated",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecExcludeRelated",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ExcludeRelatedType",
          "@type": "Annotation"
        }
      ],
      "description": "An ancestor under which a relation does not hold.",
      "comments": [
        "The relation it sits on applies through every path up the hierarchy except those through this ancestor."
      ],
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "slots": [
        "capecExcludeRelated__Exclude_ID"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Exclude_ID",
          "description": "The number of the ancestor.",
          "comments": [
            "The XSD says only that this is an ancestor, so it ranges over any entry. Every one of the 260 in CAPEC 3.9 is a category, which tests/test_catalogue.py pins."
          ],
          "range": "CapecEntry",
          "required": true,
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecExcludeRelated",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecExclusionsMixin",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecExclusionsMixin",
      "description": "The field of any relation that can leave out some ancestors.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "mixin": true,
      "slots": [
        "capecExclusionsMixin__Exclude_Related"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Exclude_Related",
          "description": "Ancestors under which the relation does not hold.",
          "range": "CapecExcludeRelated",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecExclusionsMixin",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecTaxonomyMappedMixin",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecTaxonomyMappedMixin",
      "description": "The field of an entry that can map to other taxonomies.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "mixin": true,
      "slots": [
        "capecTaxonomyMappedMixin__Taxonomy_Mappings"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Taxonomy_Mappings",
          "description": "Matching entries in other taxonomies.",
          "range": "CapecTaxonomyMapping",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecTaxonomyMappedMixin",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecSubmission",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecSubmission",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ContentHistoryType/Submission",
          "@type": "Annotation"
        }
      ],
      "description": "Who first put an entry forward, and when.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "close_mappings": [
        "sepses_capec:SubmissionHistory"
      ],
      "slots": [
        "capecSubmission__Submission_Name",
        "capecSubmission__Submission_Organization",
        "capecSubmission__Submission_Date",
        "capecSubmission__Submission_Comment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Submission_Name",
          "description": "The submitter's name.",
          "close_mappings": [
            "sepses_capec:submissionName"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "Submission_Organization",
          "description": "The submitter's organisation.",
          "close_mappings": [
            "sepses_capec:submissionOrganization"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "Submission_Date",
          "description": "The day it was submitted.",
          "close_mappings": [
            "dcterms:dateSubmitted",
            "sepses_capec:submissionDate"
          ],
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "Submission_Comment",
          "description": "A remark on the submission.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecSubmission",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecModification",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecModification",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ContentHistoryType/Modification",
          "@type": "Annotation"
        }
      ],
      "description": "One later edit to an entry.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "close_mappings": [
        "sepses_capec:ModificationHistory"
      ],
      "slots": [
        "capecModification__Modification_Name",
        "capecModification__Modification_Organization",
        "capecModification__Modification_Date",
        "capecModification__Modification_Importance",
        "capecModification__Modification_Comment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Modification_Name",
          "description": "The editor's name.",
          "close_mappings": [
            "sepses_capec:modificationName"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification_Organization",
          "description": "The editor's organisation.",
          "close_mappings": [
            "sepses_capec:modificationOrganization"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification_Date",
          "description": "The day of the edit.",
          "close_mappings": [
            "dcterms:modified",
            "sepses_capec:modificationDate"
          ],
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification_Importance",
          "description": "How much the edit matters to anyone relying on the entry.",
          "range": "CapecImportance",
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification_Comment",
          "description": "What the edit did.",
          "close_mappings": [
            "sepses_capec:modificationComment"
          ],
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecModification",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecContribution",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecContribution",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ContentHistoryType/Contribution",
          "@type": "Annotation"
        }
      ],
      "description": "Help given to an entry by someone other than its submitter.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "slots": [
        "capecContribution__Type",
        "capecContribution__Contribution_Name",
        "capecContribution__Contribution_Organization",
        "capecContribution__Contribution_Date",
        "capecContribution__Contribution_Comment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Type",
          "description": "Whether the help was content or feedback.",
          "range": "CapecContributionType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution_Name",
          "description": "The contributor's name.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution_Organization",
          "description": "The contributor's organisation.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution_Date",
          "description": "The day of the contribution.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution_Comment",
          "description": "A remark on the contribution.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecContribution",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecPreviousEntryName",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecPreviousEntryName",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ContentHistoryType/Previous_Entry_Name",
          "@type": "Annotation"
        }
      ],
      "description": "A name an entry used to carry.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "slots": [
        "capecPreviousEntryName__Date",
        "capecPreviousEntryName__Value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Date",
          "description": "The day the name changed.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Value",
          "description": "The earlier name.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecPreviousEntryName",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecContentHistory",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecContentHistory",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ContentHistoryType",
          "@type": "Annotation"
        }
      ],
      "description": "The record of who wrote and changed an entry.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "slots": [
        "capecContentHistory__Submission",
        "capecContentHistory__Modification",
        "capecContentHistory__Contribution",
        "capecContentHistory__Previous_Entry_Name"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Submission",
          "description": "The entry's first submission.",
          "range": "CapecSubmission",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification",
          "description": "Each later edit.",
          "range": "CapecModification",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution",
          "description": "Each contribution from someone else.",
          "range": "CapecContribution",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Previous_Entry_Name",
          "description": "Each name the entry used to carry.",
          "range": "CapecPreviousEntryName",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecContentHistory",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecEntry",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecEntry",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "AttackPatternType CategoryType ViewType",
          "@type": "Annotation"
        }
      ],
      "description": "Anything in the catalogue with a CAPEC number, whether an attack pattern, a category or a view.",
      "comments": [
        "The XSD has no such base. It repeats these fields on its three entry types, whose numbers do not overlap, so a member reference can point to any of them."
      ],
      "from_schema": "https://w3id.org/lmodel/capec/capec_core",
      "abstract": true,
      "slots": [
        "capecEntry__ID",
        "capecEntry__Name",
        "capecEntry__Status",
        "capecEntry__References",
        "capecEntry__Notes",
        "capecEntry__Content_History"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ID",
          "description": "The entry's CAPEC number.",
          "broad_mappings": [
            "dcterms:identifier"
          ],
          "identifier": true,
          "range": "capec_numeric_id",
          "@type": "SlotDefinition"
        },
        {
          "name": "Name",
          "description": "The entry's name.",
          "close_mappings": [
            "schema:name"
          ],
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Status",
          "description": "How far the entry has got through review.",
          "close_mappings": [
            "sepses_capec:status"
          ],
          "range": "CapecStatus",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "References",
          "description": "The external references the entry cites.",
          "close_mappings": [
            "sepses_capec:hasReference"
          ],
          "range": "CapecReference",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Notes",
          "description": "Remarks that no other field can hold.",
          "range": "CapecNote",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Content_History",
          "description": "Who wrote and changed the entry.",
          "range": "CapecContentHistory",
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecEntry",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecAlternateTerm",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecAlternateTerm",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "AlternateTermsType/Alternate_Term",
          "@type": "Annotation"
        }
      ],
      "description": "Another name by which an attack pattern is known.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "slots": [
        "capecAlternateTerm__Term",
        "capecAlternateTerm__Description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Term",
          "description": "The other name.",
          "close_mappings": [
            "skos:altLabel"
          ],
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Description",
          "description": "Where or how the other name is used.",
          "range": "capec_structured_text",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecAlternateTerm",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecRelatedAttackPattern",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecRelatedAttackPattern",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "RelatedAttackPatternType/Related_Attack_Pattern",
          "@type": "Annotation"
        }
      ],
      "description": "A relation from one attack pattern to another.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "close_mappings": [
        "sepses_capec:RelatedAttackPattern"
      ],
      "mixins": [
        "CapecExclusionsMixin"
      ],
      "slots": [
        "capecRelatedAttackPattern__Nature",
        "capecRelatedAttackPattern__CAPEC_ID",
        "capecExclusionsMixin__Exclude_Related"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Nature",
          "description": "What kind of relation it is.",
          "close_mappings": [
            "sepses_capec:relatedAttackPatternNature"
          ],
          "range": "CapecRelatedNature",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "CAPEC_ID",
          "description": "The other attack pattern.",
          "close_mappings": [
            "sepses_capec:relatedAttackPatternCAPECId"
          ],
          "range": "CapecAttackPattern",
          "required": true,
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecRelatedAttackPattern",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecTechnique",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecTechnique",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ExecutionFlowType/Attack_Step/Technique",
          "@type": "Annotation"
        }
      ],
      "description": "One way of carrying out a step of an attack.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "slots": [
        "capecTechnique__CAPEC_ID",
        "capecTechnique__Value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "CAPEC_ID",
          "description": "The entry that the technique itself amounts to.",
          "comments": [
            "The XSD types this one as xs:string and not as a number, and no technique in CAPEC 3.9 sets it. It has no pattern, so any string validates as the XSD allows, and it ranges over an entry so that the key means one thing."
          ],
          "range": "CapecEntry",
          "@type": "SlotDefinition"
        },
        {
          "name": "Value",
          "description": "The technique.",
          "range": "capec_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecTechnique",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecAttackStep",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecAttackStep",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ExecutionFlowType/Attack_Step",
          "@type": "Annotation"
        }
      ],
      "description": "One step of the way an adversary typically carries out an attack.",
      "comments": [
        "Eleven flows in CAPEC 3.9 repeat a step number, as in 1, 1, 2, 1, and the XSD does not ask for a sequence, so no rule states one."
      ],
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "close_mappings": [
        "sepses_capec:ExecutionFlow"
      ],
      "slots": [
        "capecAttackStep__Step",
        "capecAttackStep__Phase",
        "capecAttackStep__Description",
        "capecAttackStep__Technique"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Step",
          "description": "The step's number.",
          "close_mappings": [
            "sepses_capec:attackStep"
          ],
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Phase",
          "description": "The stage of the attack it belongs to.",
          "close_mappings": [
            "sepses_capec:attackStepPhase"
          ],
          "range": "CapecAttackStepPhase",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Description",
          "description": "What the adversary does in this step.",
          "close_mappings": [
            "sepses_capec:attackStepDescription"
          ],
          "range": "capec_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Technique",
          "description": "Ways of doing it.",
          "close_mappings": [
            "sepses_capec:attackStepTechnique"
          ],
          "range": "CapecTechnique",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecAttackStep",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecSkill",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecSkill",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "SkillsType/Skill",
          "@type": "Annotation"
        }
      ],
      "description": "A skill or piece of knowledge an adversary needs.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "close_mappings": [
        "sepses_capec:SkillRequired"
      ],
      "slots": [
        "capecSkill__Level",
        "capecSkill__Value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Level",
          "description": "How much of it is needed.",
          "close_mappings": [
            "sepses_capec:skillLevel"
          ],
          "range": "CapecSkillLevel",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Value",
          "description": "What the skill is.",
          "comments": [
            "The XSD allows this text to be empty, and in two skills of CAPEC 3.9 it is."
          ],
          "close_mappings": [
            "sepses_capec:skillDescription"
          ],
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecSkill",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecConsequence",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecConsequence",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ConsequencesType/Consequence",
          "@type": "Annotation"
        }
      ],
      "description": "One thing that can happen if an attack succeeds.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "close_mappings": [
        "sepses_capec:Consequence"
      ],
      "slots": [
        "capecConsequence__Consequence_ID",
        "capecConsequence__Scope",
        "capecConsequence__Impact",
        "capecConsequence__Likelihood",
        "capecConsequence__Note"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Consequence_ID",
          "description": "The CAPEC team's identifier for a consequence repeated across patterns, in the form CC-1.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Scope",
          "description": "The security properties violated.",
          "close_mappings": [
            "sepses_capec:consequenceScope"
          ],
          "range": "CapecScope",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Impact",
          "description": "What the attack does to the system.",
          "close_mappings": [
            "sepses_capec:consequenceImpact"
          ],
          "range": "CapecTechnicalImpact",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Likelihood",
          "description": "How likely this consequence is, beside the pattern's others.",
          "range": "CapecLikelihood",
          "@type": "SlotDefinition"
        },
        {
          "name": "Note",
          "description": "A remark on the consequence.",
          "close_mappings": [
            "sepses_capec:consequenceNote"
          ],
          "range": "capec_structured_text",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecConsequence",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecRelatedWeakness",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecRelatedWeakness",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "RelatedWeaknessesType/Related_Weakness",
          "@type": "Annotation"
        }
      ],
      "description": "A weakness in the Common Weakness Enumeration that can make an attack possible.",
      "comments": [
        "The XSD says that any one of a pattern's weaknesses, not all of them, may be enough for the attack to succeed.",
        "CWE holds the same link from its own side. CAPEC 3.9 and CWE 5.0 each name the same 1212 pairs, which tests/test_catalogue.py holds, so the two classes are the two ends of one link and the mapping is related."
      ],
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "close_mappings": [
        "sepses_capec:RelatedWeakness"
      ],
      "related_mappings": [
        "cwe:CweRelatedAttackPattern"
      ],
      "slots": [
        "capecRelatedWeakness__CWE_ID"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "CWE_ID",
          "description": "The weakness's number in the Common Weakness Enumeration.",
          "exact_mappings": [
            "wdt:P3624"
          ],
          "related_mappings": [
            "cwe:CweWeakness"
          ],
          "range": "capec_numeric_id",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecRelatedWeakness",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecMemberOf",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecMemberOf",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "RelationshipsType/Member_Of",
          "@type": "Annotation"
        }
      ],
      "description": "A statement that an entry belongs to a view or a category.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "mixins": [
        "CapecExclusionsMixin"
      ],
      "slots": [
        "capecMemberOf__CAPEC_ID",
        "capecExclusionsMixin__Exclude_Related"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "CAPEC_ID",
          "description": "The view or category it belongs to.",
          "range": "CapecEntry",
          "required": true,
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecMemberOf",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecHasMember",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecHasMember",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "RelationshipsType/Has_Member",
          "@type": "Annotation"
        }
      ],
      "description": "A statement that a view or a category holds an entry.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "mixins": [
        "CapecExclusionsMixin"
      ],
      "slots": [
        "capecHasMember__CAPEC_ID",
        "capecExclusionsMixin__Exclude_Related"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "CAPEC_ID",
          "description": "The attack pattern or category it holds.",
          "range": "CapecEntry",
          "required": true,
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecHasMember",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecRelationships",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecRelationships",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "RelationshipsType",
          "@type": "Annotation"
        }
      ],
      "description": "Which entries a category or a view holds, and which it belongs to.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "slots": [
        "capecRelationships__Member_Of",
        "capecRelationships__Has_Member"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Member_Of",
          "description": "What this entry belongs to.",
          "range": "CapecMemberOf",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Has_Member",
          "description": "What this entry holds.",
          "range": "CapecHasMember",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecRelationships",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecStakeholder",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecStakeholder",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "AudienceType/Stakeholder",
          "@type": "Annotation"
        }
      ],
      "description": "One kind of person a view is meant for, and what they would get from it.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "slots": [
        "capecStakeholder__Type",
        "capecStakeholder__Description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Type",
          "description": "The kind of person.",
          "range": "CapecStakeholderType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Description",
          "description": "What they would find useful in the view.",
          "range": "capec_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecStakeholder",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecAttackPattern",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecAttackPattern",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "AttackPatternType",
          "@type": "Annotation"
        }
      ],
      "description": "A catalogued way that adversaries go about an attack, with what it takes and how to resist it.",
      "comments": [
        "MITRE publishes the same entries in STIX as attack-pattern objects, in the mitre/cti repository, and marks each with a capec external reference, so the STIX mapping is close.",
        "ATT&CK describes a technique an adversary was seen to use, while this describes a general pattern, and the taxonomy mappings join them, so that mapping is only related."
      ],
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "close_mappings": [
        "stix:StixAttackPattern",
        "sepses_capec:CAPEC",
        "schema:DefinedTerm",
        "skos:Concept"
      ],
      "related_mappings": [
        "attack:AttackTechnique"
      ],
      "is_a": "CapecEntry",
      "mixins": [
        "CapecTaxonomyMappedMixin"
      ],
      "slots": [
        "capecEntry__ID",
        "capecEntry__Name",
        "capecEntry__Status",
        "capecEntry__References",
        "capecEntry__Notes",
        "capecEntry__Content_History",
        "capecAttackPattern__Abstraction",
        "capecAttackPattern__Description",
        "capecAttackPattern__Extended_Description",
        "capecAttackPattern__Alternate_Terms",
        "capecAttackPattern__Likelihood_Of_Attack",
        "capecAttackPattern__Typical_Severity",
        "capecAttackPattern__Related_Attack_Patterns",
        "capecAttackPattern__Execution_Flow",
        "capecAttackPattern__Prerequisites",
        "capecAttackPattern__Skills_Required",
        "capecAttackPattern__Resources_Required",
        "capecAttackPattern__Indicators",
        "capecAttackPattern__Consequences",
        "capecAttackPattern__Mitigations",
        "capecAttackPattern__Example_Instances",
        "capecAttackPattern__Related_Weaknesses",
        "capecTaxonomyMappedMixin__Taxonomy_Mappings"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Abstraction",
          "description": "How concrete the pattern is.",
          "close_mappings": [
            "sepses_capec:abstraction"
          ],
          "range": "CapecAbstraction",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Description",
          "description": "The pattern, in a few sentences.",
          "close_mappings": [
            "dcterms:description",
            "schema:description"
          ],
          "range": "capec_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Extended_Description",
          "description": "A longer account of the pattern.",
          "range": "capec_structured_text",
          "@type": "SlotDefinition"
        },
        {
          "name": "Alternate_Terms",
          "description": "Other names for the pattern.",
          "close_mappings": [
            "stix:aliases"
          ],
          "range": "CapecAlternateTerm",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Likelihood_Of_Attack",
          "description": "How likely an attack of this kind is to succeed.",
          "close_mappings": [
            "sepses_capec:likelihoodOfAttack"
          ],
          "range": "CapecLikelihood",
          "@type": "SlotDefinition"
        },
        {
          "name": "Typical_Severity",
          "description": "How bad the outcome usually is.",
          "close_mappings": [
            "sepses_capec:typicalSeverity"
          ],
          "range": "CapecSeverity",
          "@type": "SlotDefinition"
        },
        {
          "name": "Related_Attack_Patterns",
          "description": "The pattern's relations to others.",
          "close_mappings": [
            "sepses_capec:hasRelatedAttackPattern"
          ],
          "range": "CapecRelatedAttackPattern",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Execution_Flow",
          "description": "The steps an adversary typically takes.",
          "close_mappings": [
            "sepses_capec:hasExecutionFlow"
          ],
          "range": "CapecAttackStep",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Prerequisites",
          "description": "Conditions that must hold for the attack to work.",
          "close_mappings": [
            "sepses_capec:prerequisite"
          ],
          "range": "capec_structured_text",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Skills_Required",
          "description": "The skills an adversary needs.",
          "close_mappings": [
            "sepses_capec:hasSkillRequired"
          ],
          "range": "CapecSkill",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Resources_Required",
          "description": "What an adversary must have to hand, such as tools or addresses.",
          "close_mappings": [
            "sepses_capec:resourceRequired"
          ],
          "range": "capec_structured_text",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Indicators",
          "description": "Signs that an attack is near, under way or over.",
          "close_mappings": [
            "sepses_capec:indicator"
          ],
          "range": "capec_structured_text",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Consequences",
          "description": "What can happen if the attack succeeds.",
          "close_mappings": [
            "sepses_capec:hasConsequence"
          ],
          "range": "CapecConsequence",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Mitigations",
          "description": "Ways to prevent the attack or lessen its harm.",
          "comments": [
            "The mitre/cti repository publishes each of these as a STIX course-of-action joined by a mitigates relationship, so that mapping is only related."
          ],
          "close_mappings": [
            "sepses_capec:hasMitigation"
          ],
          "related_mappings": [
            "stix:StixCourseOfAction"
          ],
          "range": "capec_structured_text",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Example_Instances",
          "description": "Concrete examples of the attack.",
          "close_mappings": [
            "skos:example"
          ],
          "range": "capec_structured_text",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Related_Weaknesses",
          "description": "The weaknesses that can make the attack possible.",
          "close_mappings": [
            "sepses_capec:hasRelatedWeakness"
          ],
          "range": "CapecRelatedWeakness",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecAttackPattern",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecCategory",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecCategory",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "CategoryType",
          "@type": "Annotation"
        }
      ],
      "description": "A group of attack patterns that share an effect or intent, and not itself a pattern of attack.",
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "close_mappings": [
        "skos:Collection"
      ],
      "is_a": "CapecEntry",
      "mixins": [
        "CapecTaxonomyMappedMixin"
      ],
      "slots": [
        "capecEntry__ID",
        "capecEntry__Name",
        "capecEntry__Status",
        "capecEntry__References",
        "capecEntry__Notes",
        "capecEntry__Content_History",
        "capecCategory__Summary",
        "capecCategory__Relationships",
        "capecTaxonomyMappedMixin__Taxonomy_Mappings"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Summary",
          "description": "What the patterns in this category have in common.",
          "close_mappings": [
            "dcterms:description"
          ],
          "range": "capec_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Relationships",
          "description": "What the category holds and belongs to.",
          "range": "CapecRelationships",
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecCategory",
      "@type": "ClassDefinition"
    },
    {
      "name": "CapecView",
      "definition_uri": "https://w3id.org/lmodel/capec/CapecView",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ViewType",
          "@type": "Annotation"
        }
      ],
      "description": "One way of looking over the catalogue, by a hierarchy or by a slice of its entries.",
      "comments": [
        "A graph view reads as a concept scheme, while a slice is only a selection, so the mapping is related."
      ],
      "from_schema": "https://w3id.org/lmodel/capec/capec_entries",
      "related_mappings": [
        "skos:ConceptScheme"
      ],
      "is_a": "CapecEntry",
      "slots": [
        "capecEntry__ID",
        "capecEntry__Name",
        "capecEntry__Status",
        "capecEntry__References",
        "capecEntry__Notes",
        "capecEntry__Content_History",
        "capecView__Type",
        "capecView__Objective",
        "capecView__Audience",
        "capecView__Members",
        "capecView__Filter"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Type",
          "description": "How the view selects its entries.",
          "range": "CapecViewType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Objective",
          "description": "What the view is for.",
          "close_mappings": [
            "dcterms:description"
          ],
          "range": "capec_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Audience",
          "description": "Who the view is meant for.",
          "range": "CapecStakeholder",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Members",
          "description": "The entries the view holds.",
          "range": "CapecRelationships",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Filter",
          "description": "A query over the catalogue that selects the view's entries.",
          "comments": [
            "The XSD calls this an XSL query. Eight of the nine in CAPEC 3.9 are XPath 1.0, and view 553's is XPath 2.0."
          ],
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/capec/CapecView",
      "@type": "ClassDefinition"
    }
  ],
  "metamodel_version": "1.12.0",
