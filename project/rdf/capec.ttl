	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/capec/CapecExternalReference> .
<https://w3id.org/lmodel/capec/Feedback> linkml:description "Remarks on the entry." .
<https://w3id.org/lmodel/capec/Filter> a linkml:SlotDefinition ;
	skos:note "The XSD calls this an XSL query. Eight of the nine in CAPEC 3.9 are XPath 1.0, and view 553's is XPath 2.0." ;
	linkml:description "A query over the catalogue that selects the view's entries." .
<https://w3id.org/lmodel/capec/Graph> linkml:description "A hierarchy seen from one standpoint, often from category down to detailed pattern." .
