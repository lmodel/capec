	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/capec/CapecTechnicalImpact> .
<https://w3id.org/lmodel/capec/Implicit> linkml:description "A slice picked by a filter on an attribute, such as every pattern of one status." .
