	linkml:annotations _:c14n28 ;
	linkml:attributes <https://w3id.org/lmodel/capec/Audience> , <https://w3id.org/lmodel/capec/Filter> , <https://w3id.org/lmodel/capec/Members> , <https://w3id.org/lmodel/capec/Objective> , <https://w3id.org/lmodel/capec/Type> ;
