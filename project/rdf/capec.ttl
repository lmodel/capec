	linkml:range <https://w3id.org/lmodel/capec/capec_structured_text> .
<https://w3id.org/lmodel/capec/Exclude_ID> a linkml:SlotDefinition ;
	skos:note "The XSD says only that this is an ancestor, so it ranges over any entry. Every one of the 260 in CAPEC 3.9 is a category, which tests/test_catalogue.py pins." ;
	linkml:description "The number of the ancestor." ;
	linkml:pattern "^[1-9][0-9]*$" ;
	linkml:range <https://w3id.org/lmodel/capec/CapecEntry> ;
	linkml:required true .
<https://w3id.org/lmodel/capec/Exclude_Related> a linkml:SlotDefinition ;
	linkml:description "Ancestors under which the relation does not hold." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/capec/CapecExcludeRelated> .
