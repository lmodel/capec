	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/capec/CapecAttackStep> .
<https://w3id.org/lmodel/capec/Explicit> linkml:description "A slice picked by hand because of something outside the catalogue, such as a list." .
<https://w3id.org/lmodel/capec/Extended_Description> a linkml:SlotDefinition ;
	linkml:description "A longer account of the pattern." ;
	linkml:range <https://w3id.org/lmodel/capec/capec_structured_text> .
