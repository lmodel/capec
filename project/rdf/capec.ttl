<https://w3id.org/lmodel/capec/CapecAttackPattern> a linkml:ClassDefinition ;
	skos:closeMatch "schema:DefinedTerm"^^xsd:anyURI , "sepses_capec:CAPEC"^^xsd:anyURI , "skos:Concept"^^xsd:anyURI , "stix:StixAttackPattern"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/capec/capec_entries"^^xsd:anyURI ;
	skos:note "ATT&CK describes a technique an adversary was seen to use, while this describes a general pattern, and the taxonomy mappings join them, so that mapping is only related." , "MITRE publishes the same entries in STIX as attack-pattern objects, in the mitre/cti repository, and marks each with a capec external reference, so the STIX mapping is close." ;
	skos:relatedMatch "attack:AttackTechnique"^^xsd:anyURI ;
	linkml:annotations _:c14n57 ;
	linkml:attributes <https://w3id.org/lmodel/capec/Abstraction> , <https://w3id.org/lmodel/capec/Alternate_Terms> , <https://w3id.org/lmodel/capec/Consequences> , <https://w3id.org/lmodel/capec/Description> , <https://w3id.org/lmodel/capec/Example_Instances> , <https://w3id.org/lmodel/capec/Execution_Flow> , <https://w3id.org/lmodel/capec/Extended_Description> , <https://w3id.org/lmodel/capec/Indicators> , <https://w3id.org/lmodel/capec/Likelihood_Of_Attack> , <https://w3id.org/lmodel/capec/Mitigations> , <https://w3id.org/lmodel/capec/Prerequisites> , <https://w3id.org/lmodel/capec/Related_Attack_Patterns> , <https://w3id.org/lmodel/capec/Related_Weaknesses> , <https://w3id.org/lmodel/capec/Resources_Required> , <https://w3id.org/lmodel/capec/Skills_Required> , <https://w3id.org/lmodel/capec/Typical_Severity> ;
	linkml:class_uri "https://w3id.org/lmodel/capec/CapecAttackPattern"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/capec/CapecAttackPattern"^^xsd:anyURI ;
	linkml:description "A catalogued way that adversaries go about an attack, with what it takes and how to resist it." ;
	linkml:is_a <https://w3id.org/lmodel/capec/CapecEntry> ;
	linkml:mixins <https://w3id.org/lmodel/capec/CapecTaxonomyMappedMixin> ;
	linkml:slot_usage _:c14n83 ;
	linkml:slots <https://w3id.org/lmodel/capec/capecAttackPattern__Abstraction> , <https://w3id.org/lmodel/capec/capecAttackPattern__Alternate_Terms> , <https://w3id.org/lmodel/capec/capecAttackPattern__Consequences> , <https://w3id.org/lmodel/capec/capecAttackPattern__Description> , <https://w3id.org/lmodel/capec/capecAttackPattern__Example_Instances> , <https://w3id.org/lmodel/capec/capecAttackPattern__Execution_Flow> , <https://w3id.org/lmodel/capec/capecAttackPattern__Extended_Description> , <https://w3id.org/lmodel/capec/capecAttackPattern__Indicators> , <https://w3id.org/lmodel/capec/capecAttackPattern__Likelihood_Of_Attack> , <https://w3id.org/lmodel/capec/capecAttackPattern__Mitigations> , <https://w3id.org/lmodel/capec/capecAttackPattern__Prerequisites> , <https://w3id.org/lmodel/capec/capecAttackPattern__Related_Attack_Patterns> , <https://w3id.org/lmodel/capec/capecAttackPattern__Related_Weaknesses> , <https://w3id.org/lmodel/capec/capecAttackPattern__Resources_Required> , <https://w3id.org/lmodel/capec/capecAttackPattern__Skills_Required> , <https://w3id.org/lmodel/capec/capecAttackPattern__Typical_Severity> , <https://w3id.org/lmodel/capec/capecEntry__Content_History> , <https://w3id.org/lmodel/capec/capecEntry__ID> , <https://w3id.org/lmodel/capec/capecEntry__Name> , <https://w3id.org/lmodel/capec/capecEntry__Notes> , <https://w3id.org/lmodel/capec/capecEntry__References> , <https://w3id.org/lmodel/capec/capecEntry__Status> , <https://w3id.org/lmodel/capec/capecTaxonomyMappedMixin__Taxonomy_Mappings> .
