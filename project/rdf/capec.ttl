	skos:inScheme "https://w3id.org/lmodel/capec/capec_entries"^^xsd:anyURI ;
	skos:prefLabel "Type" ;
	linkml:description "How the view selects its entries." ;
	linkml:domain_of <https://w3id.org/lmodel/capec/CapecView> ;
	linkml:owner <https://w3id.org/lmodel/capec/CapecView> ;
	linkml:range <https://w3id.org/lmodel/capec/CapecViewType> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/capec/Type"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/capec_day> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/capec/capec_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/capec/CapecDay"^^xsd:anyURI ;
	linkml:description "A day of the month in the XSD's xs:gDay form, such as ---08." ;
	linkml:pattern "^---(0[1-9]|[12][0-9]|3[01])(Z|[+-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?$" ;
	linkml:typeof <https://w3id.org/lmodel/capec/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/capec_month> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/capec/capec_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/capec/CapecMonth"^^xsd:anyURI ;
	linkml:description "A month in the XSD's xs:gMonth form, such as --02 for February." ;
	linkml:pattern "^--(0[1-9]|1[0-2])(Z|[+-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?$" ;
	linkml:typeof <https://w3id.org/lmodel/capec/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/capec_numeric_id> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/capec/capec_core"^^xsd:anyURI ;
	skos:note "The XSD types these as xs:integer. They name things and nothing counts them, and the rdflib dumper in linkml-runtime 1.12.1 cannot turn a bare identifier into an IRI, so the digits stay a string." ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/capec/CapecNumericId"^^xsd:anyURI ;
	linkml:description "The number of a CAPEC entry or a CWE weakness, written as a string of digits." ;
	linkml:pattern "^[1-9][0-9]*$" ;
	linkml:typeof <https://w3id.org/lmodel/capec/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/capec_reference_id> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/capec/capec_core"^^xsd:anyURI ;
	skos:note "The XSD types this as xs:string and gives REF-1 as its form, which every reference in the catalogue follows." ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/capec/CapecReferenceId"^^xsd:anyURI ;
	linkml:description "The identifier of an external reference, such as REF-1." ;
	linkml:pattern "^REF-[0-9]+$" ;
	linkml:typeof <https://w3id.org/lmodel/capec/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/capec_structured_text> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/capec/capec_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/capec/CapecStructuredText"^^xsd:anyURI ;
	linkml:description "Text that may hold XHTML markup such as paragraphs and lists, with no namespace prefix." ;
	linkml:typeof <https://w3id.org/lmodel/capec/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/capec_uri> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/capec/capec_core"^^xsd:anyURI ;
	skos:note "LinkML's own uri type asks for an RFC 3986 URI, which the validator enforces, and anyURI also admits a relative reference. CAPEC 3.9 writes none, but lmodel/cwe's catalogue does, and both schemas keep the XSD's looseness." ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/capec/CapecUri"^^xsd:anyURI ;
	linkml:description "An address, as XML Schema's anyURI admits it." ;
	linkml:typeof <https://w3id.org/lmodel/capec/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/capec_year> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/capec/capec_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/capec/CapecYear"^^xsd:anyURI ;
	linkml:description "A year in the XSD's xs:gYear form, such as 2004." ;
	linkml:pattern "^-?([1-9][0-9]{3,}|0[0-9]{3})(Z|[+-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?$" ;
	linkml:typeof <https://w3id.org/lmodel/capec/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/curie> dcterms:conformsTo "https://www.w3.org/TR/curie/" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations this MUST be expanded to a URI" , "in non-RDF serializations MAY be serialized as the compact representation" ;
	linkml:base "Curie" ;
	linkml:definition_uri "https://w3id.org/linkml/Curie"^^xsd:anyURI ;
	linkml:description "a compact URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/date> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"." , "URI is dateTime because OWL reasoners don't work with straight date or time" ;
	skos:exactMatch "schema:Date"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDDate" ;
	linkml:definition_uri "https://w3id.org/linkml/Date"^^xsd:anyURI ;
	linkml:description "a date (year, month and day) in an idealized calendar" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#date"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/date_or_datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"." ;
