	linkml:description "Which edition of the work is meant." .
<https://w3id.org/lmodel/capec/Entry_ID> a linkml:SlotDefinition ;
	linkml:description "The other entry's identifier in that taxonomy." .
<https://w3id.org/lmodel/capec/Entry_Name> a linkml:SlotDefinition ;
	linkml:description "The other entry's name in that taxonomy." .
<https://w3id.org/lmodel/capec/Exact> skos:closeMatch "skos:exactMatch"^^xsd:anyURI .
