<https://w3id.org/lmodel/capec/Deprecated> linkml:description "Withdrawn from the catalogue, though its number stays taken." .
<https://w3id.org/lmodel/capec/Description> a linkml:SlotDefinition ;
	skos:closeMatch "dcterms:description"^^xsd:anyURI , "schema:description"^^xsd:anyURI , "sepses_capec:attackStepDescription"^^xsd:anyURI ;
	linkml:description "The pattern, in a few sentences." , "What the adversary does in this step." , "What they would find useful in the view." , "Where or how the other name is used." ;
