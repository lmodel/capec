<https://w3id.org/lmodel/capec/ATTACK> linkml:description "MITRE ATT&CK. An entry's Entry_ID there is the technique's number without its T." .
<https://w3id.org/lmodel/capec/Abstraction> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_capec:abstraction"^^xsd:anyURI ;
	linkml:description "How concrete the pattern is." ;
	linkml:range <https://w3id.org/lmodel/capec/CapecAbstraction> ;
	linkml:required true .
<https://w3id.org/lmodel/capec/Alternate_Terms> a linkml:SlotDefinition ;
	skos:closeMatch "stix:aliases"^^xsd:anyURI ;
	linkml:description "Other names for the pattern." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/capec/CapecAlternateTerm> .
<https://w3id.org/lmodel/capec/Attack_Patterns> a linkml:SlotDefinition ;
	linkml:description "The attack patterns." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/capec/CapecAttackPattern> .
<https://w3id.org/lmodel/capec/Audience> a linkml:SlotDefinition ;
	linkml:description "Who the view is meant for." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/capec/CapecStakeholder> .
<https://w3id.org/lmodel/capec/Author> a linkml:SlotDefinition ;
	skos:closeMatch "dcterms:creator"^^xsd:anyURI , "sepses_capec:referenceAuthor"^^xsd:anyURI ;
	linkml:description "A person or body who wrote the work." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/capec/CAPEC%20More%20Abstract> skos:closeMatch "skos:narrowMatch"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/CAPEC%20More%20Specific> skos:closeMatch "skos:broadMatch"^^xsd:anyURI .
<https://w3id.org/lmodel/capec/CAPEC_ID> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_capec:relatedAttackPatternCAPECId"^^xsd:anyURI ;
	skos:note "The XSD types this one as xs:string and not as a number, and no technique in CAPEC 3.9 sets it. It has no pattern, so any string validates as the XSD allows, and it ranges over an entry so that the key means one thing." ;
	linkml:description "The attack pattern or category it holds." , "The entry that the technique itself amounts to." , "The other attack pattern." , "The view or category it belongs to." ;
	linkml:pattern "^[1-9][0-9]*$" ;
	linkml:range <https://w3id.org/lmodel/capec/CapecAttackPattern> , <https://w3id.org/lmodel/capec/CapecEntry> ;
	linkml:required true .
<https://w3id.org/lmodel/capec/CWE_ID> a linkml:SlotDefinition ;
	skos:exactMatch "wdt:P3624"^^xsd:anyURI ;
	skos:relatedMatch "cwe:CweWeakness"^^xsd:anyURI ;
	linkml:description "The weakness's number in the Common Weakness Enumeration." ;
	linkml:range <https://w3id.org/lmodel/capec/capec_numeric_id> ;
	linkml:required true .
<https://w3id.org/lmodel/capec/CanAlsoBe> linkml:description "In some settings this pattern can also be read as the other one, though not always the reverse." .
<https://w3id.org/lmodel/capec/CanFollow> linkml:annotations _:c14n70 ;
	linkml:description "In a chain of attack, this pattern may come after the other." .
<https://w3id.org/lmodel/capec/CanPrecede> linkml:annotations _:c14n64 ;
	linkml:description "In a chain of attack, this pattern may come before the other." .
<https://w3id.org/lmodel/capec/CapecAbstraction> skos:inScheme "https://w3id.org/lmodel/capec/capec_entries"^^xsd:anyURI ;
	linkml:annotations _:c14n31 ;
	linkml:definition_uri "https://w3id.org/lmodel/capec/CapecAbstraction"^^xsd:anyURI ;
	linkml:description "How concrete an attack pattern is." ;
	linkml:permissible_values <https://w3id.org/lmodel/capec/Detailed> , <https://w3id.org/lmodel/capec/Meta> , <https://w3id.org/lmodel/capec/Standard> .
<https://w3id.org/lmodel/capec/CapecAlternateTerm> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/capec/capec_entries"^^xsd:anyURI ;
	linkml:annotations _:c14n1 ;
	linkml:attributes <https://w3id.org/lmodel/capec/Description> , <https://w3id.org/lmodel/capec/Term> ;
