	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#consequenceImpact> ;
	skos:definition "What the attack does to the system." ;
	skos:inScheme capec:capec_entries .
capec:Indicators a owl:DatatypeProperty ;
	rdfs:label "Indicators" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#indicator> ;
	skos:definition "Signs that an attack is near, under way or over." ;
	skos:inScheme capec:capec_entries .
capec:Level a owl:ObjectProperty ;
	rdfs:label "Level" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#skillLevel> ;
	skos:definition "How much of it is needed." ;
	skos:inScheme capec:capec_entries .
capec:Likelihood a owl:ObjectProperty ;
	rdfs:label "Likelihood" ;
	skos:definition "How likely this consequence is, beside the pattern's others." ;
	skos:inScheme capec:capec_entries .
capec:Likelihood_Of_Attack a owl:ObjectProperty ;
	rdfs:label "Likelihood_Of_Attack" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#likelihoodOfAttack> ;
	skos:definition "How likely an attack of this kind is to succeed." ;
	skos:inScheme capec:capec_entries .
capec:Mapping_Fit a owl:ObjectProperty ;
	rdfs:label "Mapping_Fit" ;
	skos:definition "How well the two entries fit." ;
	skos:inScheme capec:capec_core .
capec:Member_Of a owl:ObjectProperty ;
	rdfs:label "Member_Of" ;
	skos:definition "What this entry belongs to." ;
	skos:inScheme capec:capec_entries .
capec:Members a owl:ObjectProperty ;
	rdfs:label "Members" ;
	skos:definition "The entries the view holds." ;
	skos:inScheme capec:capec_entries .
capec:Mitigations a owl:DatatypeProperty ;
	rdfs:label "Mitigations" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#hasMitigation> ;
	skos:definition "Ways to prevent the attack or lessen its harm." ;
	skos:inScheme capec:capec_entries ;
	skos:note "The mitre/cti repository publishes each of these as a STIX course-of-action joined by a mitigates relationship, so that mapping is only related." ;
	skos:relatedMatch <https://w3id.org/lmodel/stix/StixCourseOfAction> .
capec:Modification a owl:ObjectProperty ;
	rdfs:label "Modification" ;
	skos:definition "Each later edit." ;
	skos:inScheme capec:capec_core .
capec:Modification_Comment a owl:DatatypeProperty ;
	rdfs:label "Modification_Comment" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#modificationComment> ;
	skos:definition "What the edit did." ;
	skos:inScheme capec:capec_core .
capec:Modification_Date a owl:DatatypeProperty ;
	rdfs:label "Modification_Date" ;
	skos:closeMatch dcterms:modified , <http://w3id.org/sepses/vocab/ref/capec#modificationDate> ;
	skos:definition "The day of the edit." ;
	skos:inScheme capec:capec_core .
capec:Modification_Importance a owl:ObjectProperty ;
	rdfs:label "Modification_Importance" ;
	skos:definition "How much the edit matters to anyone relying on the entry." ;
	skos:inScheme capec:capec_core .
capec:Modification_Name a owl:DatatypeProperty ;
	rdfs:label "Modification_Name" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#modificationName> ;
	skos:definition "The editor's name." ;
	skos:inScheme capec:capec_core .
capec:Modification_Organization a owl:DatatypeProperty ;
	rdfs:label "Modification_Organization" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#modificationOrganization> ;
	skos:definition "The editor's organisation." ;
	skos:inScheme capec:capec_core .
capec:Name a owl:DatatypeProperty .
capec:Nature a owl:ObjectProperty ;
	rdfs:label "Nature" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#relatedAttackPatternNature> ;
	skos:definition "What kind of relation it is." ;
	skos:inScheme capec:capec_entries .
capec:Note a owl:DatatypeProperty ;
	rdfs:label "Note" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#consequenceNote> ;
	skos:definition "A remark on the consequence." ;
	skos:inScheme capec:capec_entries .
capec:Notes a owl:ObjectProperty ;
	rdfs:label "Notes" ;
	skos:definition "Remarks that no other field can hold." ;
	skos:inScheme capec:capec_core .
capec:Objective a owl:DatatypeProperty ;
	rdfs:label "Objective" ;
	skos:closeMatch dcterms:description ;
	skos:definition "What the view is for." ;
	skos:inScheme capec:capec_entries .
capec:Phase a owl:ObjectProperty ;
	rdfs:label "Phase" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#attackStepPhase> ;
	skos:definition "The stage of the attack it belongs to." ;
	skos:inScheme capec:capec_entries .
capec:Prerequisites a owl:DatatypeProperty ;
	rdfs:label "Prerequisites" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#prerequisite> ;
	skos:definition "Conditions that must hold for the attack to work." ;
	skos:inScheme capec:capec_entries .
capec:Previous_Entry_Name a owl:ObjectProperty ;
	rdfs:label "Previous_Entry_Name" ;
