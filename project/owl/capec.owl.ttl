	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#referencePublicationDay> ;
	skos:definition "The day of the month it appeared." ;
	skos:inScheme capec:capec_core .
capec:Publication_Month a owl:DatatypeProperty ;
	rdfs:label "Publication_Month" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#referencePublicationMonth> ;
	skos:definition "The month it appeared." ;
	skos:inScheme capec:capec_core .
capec:Publication_Year a owl:DatatypeProperty ;
	rdfs:label "Publication_Year" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#referencePublicationYear> ;
