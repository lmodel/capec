<https://w3id.org/lmodel/capec.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://capec.mitre.org/data/xsd/ap_schema_v3.5.xsd> ;
	dcterms:title "Common Attack Pattern Enumeration and Classification (CAPEC)" ;
	pav:version "3.9" ;
	schema1:keywords "CAPEC" , "MITRE" , "adversary technique" , "attack pattern" , "threat modelling" ;
	a owl:Ontology ;
	rdfs:label "capec" ;
	rdfs:seeAlso <https://capec.mitre.org/> , <https://lmodel.github.io/capec> ;
	skos:definition "A LinkML model of the CAPEC catalogue. It keeps the keys and listed values of the catalogue's XML Schema, so the catalogue validates as MITRE spells it once scripts/capec_to_json.py has turned it into data." ;
	skos:note "MITRE's latest catalogue is dated January 2023 and its latest news item March 2023. No page says CAPEC has stopped, so the watch keeps asking." , "The version is the version of the catalogue that the schema renders, and xsd_version is the version of the XSD that catalogue names. upstream/ holds both files unchanged, tests/test_coverage.py holds the schema to the XSD, and scripts/check_upstream_release.py reports when either moves." ;
	capec:catalogue_date "2023-01-24" ;
	capec:xsd_date "2021-10-21" ;
	capec:xsd_namespace "http://capec.mitre.org/capec-3" ;
	capec:xsd_version "3.5" .
capec:Abstraction a owl:ObjectProperty ;
	rdfs:label "Abstraction" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#abstraction> ;
	skos:definition "How concrete the pattern is." ;
	skos:inScheme capec:capec_entries .
capec:Alternate_Terms a owl:ObjectProperty ;
	rdfs:label "Alternate_Terms" ;
	skos:closeMatch <https://w3id.org/lmodel/stix/aliases> ;
	skos:definition "Other names for the pattern." ;
	skos:inScheme capec:capec_entries .
capec:Attack_Patterns a owl:ObjectProperty ;
	rdfs:label "Attack_Patterns" ;
	skos:definition "The attack patterns." ;
	skos:inScheme <https://w3id.org/lmodel/capec> .
capec:Audience a owl:ObjectProperty ;
	rdfs:label "Audience" ;
	skos:definition "Who the view is meant for." ;
	skos:inScheme capec:capec_entries .
capec:Author a owl:DatatypeProperty ;
	rdfs:label "Author" ;
	skos:closeMatch dcterms:creator , <http://w3id.org/sepses/vocab/ref/capec#referenceAuthor> ;
	skos:definition "A person or body who wrote the work." ;
	skos:inScheme capec:capec_core .
capec:CAPEC_ID a owl:ObjectProperty .
capec:CWE_ID a owl:DatatypeProperty ;
	rdfs:label "CWE_ID" ;
	skos:definition "The weakness's number in the Common Weakness Enumeration." ;
	skos:exactMatch <http://www.wikidata.org/prop/direct/P3624> ;
	skos:inScheme capec:capec_entries .
capec:CapecAbstraction\#Detailed a owl:Class ;
	rdfs:label "Detailed" ;
	rdfs:subClassOf capec:CapecAbstraction ;
	skos:definition "One technique against one technology, usually with its steps set out." .
capec:CapecAbstraction\#Meta a owl:Class ;
	rdfs:label "Meta" ;
	rdfs:subClassOf capec:CapecAbstraction ;
	skos:definition "A broad approach, free of any one technology, for use in design-level threat modelling." .
capec:CapecAbstraction\#Standard a owl:Class ;
	rdfs:label "Standard" ;
	rdfs:subClassOf capec:CapecAbstraction ;
	skos:definition "One method or technique, often only a part of a whole attack." .
capec:CapecAbstraction a owl:Class ;
	rdfs:label "CapecAbstraction" ;
	owl:unionOf _:c14n274 ;
	skos:definition "How concrete an attack pattern is." ;
	skos:inScheme capec:capec_entries ;
	linkml:permissible_values capec:CapecAbstraction\#Detailed , capec:CapecAbstraction\#Meta , capec:CapecAbstraction\#Standard ;
	capec:xsd_type "AbstractionEnumeration" .
capec:CapecAlternateTerm a owl:Class ;
	rdfs:label "CapecAlternateTerm" ;
	rdfs:subClassOf _:c14n125 , _:c14n138 , _:c14n30 , _:c14n354 , _:c14n374 , _:c14n51 ;
	skos:definition "Another name by which an attack pattern is known." ;
	skos:inScheme capec:capec_entries ;
	capec:xsd_type "AlternateTermsType/Alternate_Term" .
capec:CapecAttackPattern a owl:Class ;
	rdfs:label "CapecAttackPattern" ;
	rdfs:subClassOf capec:CapecEntry , capec:CapecTaxonomyMappedMixin , _:c14n102 , _:c14n11 , _:c14n117 , _:c14n121 , _:c14n126 , _:c14n129 , _:c14n13 , _:c14n137 , _:c14n14 , _:c14n171 , _:c14n18 , _:c14n182 , _:c14n19 , _:c14n196 , _:c14n206 , _:c14n221 , _:c14n223 , _:c14n226 , _:c14n247 , _:c14n270 , _:c14n275 , _:c14n281 , _:c14n284 , _:c14n294 , _:c14n295 , _:c14n300 , _:c14n325 , _:c14n343 , _:c14n345 , _:c14n368 , _:c14n47 , _:c14n64 , _:c14n80 , _:c14n84 , _:c14n86 , _:c14n90 , _:c14n99 ;
	skos:closeMatch schema1:DefinedTerm , <http://w3id.org/sepses/vocab/ref/capec#CAPEC> , skos:Concept , <https://w3id.org/lmodel/stix/StixAttackPattern> ;
	skos:definition "A catalogued way that adversaries go about an attack, with what it takes and how to resist it." ;
	skos:inScheme capec:capec_entries ;
	skos:note "ATT&CK describes a technique an adversary was seen to use, while this describes a general pattern, and the taxonomy mappings join them, so that mapping is only related." , "MITRE publishes the same entries in STIX as attack-pattern objects, in the mitre/cti repository, and marks each with a capec external reference, so the STIX mapping is close." ;
	skos:relatedMatch <https://w3id.org/lmodel/attack/AttackTechnique> ;
	capec:xsd_type "AttackPatternType" .
capec:CapecAttackPatternCatalog a owl:Class ;
	rdfs:label "CapecAttackPatternCatalog" ;
	rdfs:subClassOf _:c14n139 , _:c14n145 , _:c14n175 , _:c14n199 , _:c14n227 , _:c14n234 , _:c14n241 , _:c14n277 , _:c14n296 , _:c14n319 , _:c14n321 , _:c14n330 , _:c14n334 , _:c14n355 , _:c14n369 , _:c14n373 , _:c14n57 ;
	skos:closeMatch schema1:DefinedTermSet , skos:ConceptScheme , wd:Q2986817 ;
	skos:definition "One release of the whole catalogue, with its entries and the references they share." ;
	skos:inScheme <https://w3id.org/lmodel/capec> ;
	capec:xsd_type "Attack_Pattern_Catalog" .
capec:CapecAttackStep a owl:Class ;
	rdfs:label "CapecAttackStep" ;
	rdfs:subClassOf _:c14n1 , _:c14n106 , _:c14n112 , _:c14n132 , _:c14n167 , _:c14n181 , _:c14n307 , _:c14n376 , _:c14n43 , _:c14n72 , _:c14n94 ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#ExecutionFlow> ;
	skos:definition "One step of the way an adversary typically carries out an attack." ;
	skos:inScheme capec:capec_entries ;
	skos:note "Eleven flows in CAPEC 3.9 repeat a step number, as in 1, 1, 2, 1, and the XSD does not ask for a sequence, so no rule states one." ;
	capec:xsd_type "ExecutionFlowType/Attack_Step" .
capec:CapecAttackStepPhase\#Experiment a owl:Class ;
	rdfs:label "Experiment" ;
	rdfs:subClassOf capec:CapecAttackStepPhase ;
	skos:definition "Trying things out against it." .
capec:CapecAttackStepPhase\#Exploit a owl:Class ;
	rdfs:label "Exploit" ;
	rdfs:subClassOf capec:CapecAttackStepPhase ;
	skos:definition "Carrying the attack through." .
capec:CapecAttackStepPhase\#Explore a owl:Class ;
	rdfs:label "Explore" ;
	rdfs:subClassOf capec:CapecAttackStepPhase ;
	skos:definition "Looking over the target." .
capec:CapecAttackStepPhase a owl:Class ;
	rdfs:label "CapecAttackStepPhase" ;
	owl:unionOf _:c14n273 ;
	skos:definition "Which stage of an attack a step belongs to." ;
	skos:inScheme capec:capec_entries ;
	linkml:permissible_values capec:CapecAttackStepPhase\#Experiment , capec:CapecAttackStepPhase\#Exploit , capec:CapecAttackStepPhase\#Explore ;
	capec:xsd_type "ExecutionFlowType/Attack_Step/Phase" .
capec:CapecCategory a owl:Class ;
	rdfs:label "CapecCategory" ;
	rdfs:subClassOf capec:CapecEntry , capec:CapecTaxonomyMappedMixin , _:c14n153 , _:c14n204 , _:c14n286 , _:c14n362 , _:c14n367 , _:c14n70 ;
	skos:closeMatch skos:Collection ;
	skos:definition "A group of attack patterns that share an effect or intent, and not itself a pattern of attack." ;
	skos:inScheme capec:capec_entries ;
	capec:xsd_type "CategoryType" .
capec:CapecConsequence a owl:Class ;
	rdfs:label "CapecConsequence" ;
	rdfs:subClassOf _:c14n128 , _:c14n172 , _:c14n173 , _:c14n185 , _:c14n21 , _:c14n217 , _:c14n279 , _:c14n3 , _:c14n359 , _:c14n365 , _:c14n375 , _:c14n79 , _:c14n97 ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#Consequence> ;
	skos:definition "One thing that can happen if an attack succeeds." ;
	skos:inScheme capec:capec_entries ;
	capec:xsd_type "ConsequencesType/Consequence" .
capec:CapecContentHistory a owl:Class ;
	rdfs:label "CapecContentHistory" ;
	rdfs:subClassOf _:c14n118 , _:c14n148 , _:c14n230 , _:c14n251 , _:c14n292 , _:c14n312 , _:c14n344 , _:c14n5 , _:c14n58 ;
	skos:definition "The record of who wrote and changed an entry." ;
	skos:inScheme capec:capec_core ;
	capec:xsd_type "ContentHistoryType" .
capec:CapecContribution a owl:Class ;
	rdfs:label "CapecContribution" ;
	rdfs:subClassOf _:c14n133 , _:c14n161 , _:c14n188 , _:c14n209 , _:c14n249 , _:c14n254 , _:c14n26 , _:c14n262 , _:c14n305 , _:c14n309 , _:c14n311 , _:c14n361 , _:c14n37 , _:c14n4 , _:c14n68 ;
	skos:definition "Help given to an entry by someone other than its submitter." ;
	skos:inScheme capec:capec_core ;
	capec:xsd_type "ContentHistoryType/Contribution" .
capec:CapecContributionType\#Content a owl:Class ;
	rdfs:label "Content" ;
	rdfs:subClassOf capec:CapecContributionType ;
	skos:definition "Text given to the entry." .
capec:CapecContributionType\#Feedback a owl:Class ;
	rdfs:label "Feedback" ;
	rdfs:subClassOf capec:CapecContributionType ;
	skos:definition "Remarks on the entry." .
capec:CapecContributionType a owl:Class ;
	rdfs:label "CapecContributionType" ;
	owl:unionOf _:c14n310 ;
	skos:definition "Whether a contribution changed an entry's content or only commented on it." ;
	skos:inScheme capec:capec_core ;
	linkml:permissible_values capec:CapecContributionType\#Content , capec:CapecContributionType\#Feedback ;
	capec:xsd_type "ContentHistoryType/Contribution/@Type" .
capec:CapecDay a rdfs:Datatype ;
	owl:equivalentClass _:c14n168 .
capec:CapecEntry a owl:Class ;
	rdfs:label "CapecEntry" ;
	rdfs:subClassOf _:c14n140 , _:c14n186 , _:c14n231 , _:c14n235 , _:c14n244 , _:c14n276 , _:c14n290 , _:c14n301 , _:c14n315 , _:c14n331 , _:c14n349 , _:c14n350 , _:c14n357 , _:c14n36 , _:c14n370 , _:c14n48 , _:c14n49 ;
	skos:definition "Anything in the catalogue with a CAPEC number, whether an attack pattern, a category or a view." ;
	skos:inScheme capec:capec_core ;
	skos:note "The XSD has no such base. It repeats these fields on its three entry types, whose numbers come from one sequence, so a member reference can point to any of them." ;
	capec:xsd_type "AttackPatternType CategoryType ViewType" .
capec:CapecExcludeRelated a owl:Class ;
	rdfs:label "CapecExcludeRelated" ;
	rdfs:subClassOf _:c14n163 , _:c14n184 , _:c14n93 ;
	skos:definition "An ancestor under which a relation does not hold." ;
	skos:inScheme capec:capec_core ;
	skos:note "The relation it sits on applies through every path up the hierarchy except those through this ancestor." ;
	capec:xsd_type "ExcludeRelatedType" .
capec:CapecExclusionsMixin a owl:Class ;
	rdfs:label "CapecExclusionsMixin" ;
	rdfs:subClassOf _:c14n342 , _:c14n78 ;
	skos:definition "The field of any relation that can leave out some ancestors." ;
	skos:inScheme capec:capec_core .
capec:CapecExternalReference a owl:Class ;
	rdfs:label "CapecExternalReference" ;
	rdfs:subClassOf _:c14n104 , _:c14n107 , _:c14n12 , _:c14n141 , _:c14n150 , _:c14n154 , _:c14n183 , _:c14n189 , _:c14n191 , _:c14n194 , _:c14n207 , _:c14n213 , _:c14n218 , _:c14n225 , _:c14n23 , _:c14n24 , _:c14n242 , _:c14n245 , _:c14n253 , _:c14n265 , _:c14n299 , _:c14n302 , _:c14n318 , _:c14n326 , _:c14n335 , _:c14n35 , _:c14n352 , _:c14n356 , _:c14n358 , _:c14n364 , _:c14n69 , _:c14n73 ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#Reference> , <https://w3id.org/lmodel/stix/StixExternalReference> ;
	skos:definition "A publication or page outside CAPEC that entries point to for more detail." ;
	skos:inScheme capec:capec_core ;
	capec:xsd_type "ExternalReferenceType" .
capec:CapecHasMember a owl:Class ;
	rdfs:label "CapecHasMember" ;
	rdfs:subClassOf capec:CapecExclusionsMixin , _:c14n164 , _:c14n202 , _:c14n246 ;
	skos:definition "A statement that a view or a category holds an entry." ;
	skos:inScheme capec:capec_entries ;
	capec:xsd_type "RelationshipsType/Has_Member" .
capec:CapecImportance\#Critical a owl:Class ;
	rdfs:label "Critical" ;
	rdfs:subClassOf capec:CapecImportance ;
	skos:definition "A change to the entry's meaning or to how it may be read." .
capec:CapecImportance\#Normal a owl:Class ;
	rdfs:label "Normal" ;
	rdfs:subClassOf capec:CapecImportance ;
	skos:definition "A change that leaves the entry's meaning as it was." .
capec:CapecImportance a owl:Class ;
	rdfs:label "CapecImportance" ;
	owl:unionOf _:c14n45 ;
	skos:definition "How much a change to an entry matters to anyone relying on it." ;
	skos:inScheme capec:capec_core ;
	linkml:permissible_values capec:CapecImportance\#Critical , capec:CapecImportance\#Normal ;
	capec:xsd_type "ImportanceEnumeration" .
capec:CapecLikelihood\#High a owl:Class ;
	rdfs:label "High" ;
	rdfs:subClassOf capec:CapecLikelihood .
capec:CapecLikelihood\#Low a owl:Class ;
	rdfs:label "Low" ;
	rdfs:subClassOf capec:CapecLikelihood .
capec:CapecLikelihood\#Medium a owl:Class ;
	rdfs:label "Medium" ;
	rdfs:subClassOf capec:CapecLikelihood .
capec:CapecLikelihood\#Unknown a owl:Class ;
	rdfs:label "Unknown" ;
	rdfs:subClassOf capec:CapecLikelihood ;
	skos:definition "Nobody knows how likely it is." .
capec:CapecLikelihood a owl:Class ;
	rdfs:label "CapecLikelihood" ;
	owl:unionOf _:c14n9 ;
	skos:definition "How likely something is to happen." ;
	skos:inScheme capec:capec_entries ;
	linkml:permissible_values capec:CapecLikelihood\#High , capec:CapecLikelihood\#Low , capec:CapecLikelihood\#Medium , capec:CapecLikelihood\#Unknown ;
	capec:xsd_type "LikelihoodEnumeration" .
capec:CapecMemberOf a owl:Class ;
	rdfs:label "CapecMemberOf" ;
	rdfs:subClassOf capec:CapecExclusionsMixin , _:c14n201 , _:c14n240 , _:c14n88 ;
	skos:definition "A statement that an entry belongs to a view or a category." ;
	skos:inScheme capec:capec_entries ;
	capec:xsd_type "RelationshipsType/Member_Of" .
capec:CapecModification a owl:Class ;
	rdfs:label "CapecModification" ;
	rdfs:subClassOf _:c14n113 , _:c14n159 , _:c14n16 , _:c14n180 , _:c14n222 , _:c14n238 , _:c14n250 , _:c14n272 , _:c14n287 , _:c14n288 , _:c14n293 , _:c14n322 , _:c14n40 , _:c14n81 , _:c14n98 ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#ModificationHistory> ;
	skos:definition "One later edit to an entry." ;
	skos:inScheme capec:capec_core ;
	capec:xsd_type "ContentHistoryType/Modification" .
capec:CapecMonth a rdfs:Datatype ;
	owl:equivalentClass _:c14n92 .
capec:CapecNote a owl:Class ;
	rdfs:label "CapecNote" ;
	rdfs:subClassOf _:c14n160 , _:c14n205 , _:c14n220 , _:c14n282 , _:c14n360 , _:c14n71 ;
	skos:closeMatch skos:note ;
	skos:definition "A remark on an entry that no other field can hold." ;
	skos:inScheme capec:capec_core ;
	capec:xsd_type "NotesType/Note" .
capec:CapecNoteType\#Maintenance a owl:Class ;
	rdfs:label "Maintenance" ;
	rdfs:subClassOf capec:CapecNoteType ;
	skos:definition "Work on the entry still to be done." .
capec:CapecNoteType\#Other a owl:Class ;
	rdfs:label "Other" ;
	rdfs:subClassOf capec:CapecNoteType ;
	skos:definition "A remark of no listed kind." .
capec:CapecNoteType\#Relationship a owl:Class ;
	rdfs:label "Relationship" ;
	rdfs:subClassOf capec:CapecNoteType ;
	skos:definition "Detail on how entries relate." .
capec:CapecNoteType\#Research\%20Gap a owl:Class ;
	rdfs:label "Research Gap" ;
	rdfs:subClassOf capec:CapecNoteType ;
	skos:definition "Something the research community could look into further." .
capec:CapecNoteType\#Terminology a owl:Class ;
	rdfs:label "Terminology" ;
	rdfs:subClassOf capec:CapecNoteType ;
	skos:definition "A question of wording, such as competing uses of one term." .
capec:CapecNoteType a owl:Class ;
	rdfs:label "CapecNoteType" ;
	owl:unionOf _:c14n103 ;
	skos:definition "What kind of remark a note makes." ;
	skos:inScheme capec:capec_core ;
	linkml:permissible_values capec:CapecNoteType\#Maintenance , capec:CapecNoteType\#Other , capec:CapecNoteType\#Relationship , capec:CapecNoteType\#Research\%20Gap , capec:CapecNoteType\#Terminology ;
	capec:xsd_type "NoteTypeEnumeration" .
capec:CapecNumericId a rdfs:Datatype ;
	owl:equivalentClass _:c14n66 .
capec:CapecPreviousEntryName a owl:Class ;
	rdfs:label "CapecPreviousEntryName" ;
	rdfs:subClassOf _:c14n151 , _:c14n229 , _:c14n29 , _:c14n314 , _:c14n41 , _:c14n76 ;
	skos:definition "A name an entry used to carry." ;
	skos:inScheme capec:capec_core ;
	capec:xsd_type "ContentHistoryType/Previous_Entry_Name" .
capec:CapecReference a owl:Class ;
	rdfs:label "CapecReference" ;
	rdfs:subClassOf _:c14n15 , _:c14n198 , _:c14n264 , _:c14n316 , _:c14n327 , _:c14n8 ;
	skos:definition "One citation by an entry of an external reference." ;
	skos:inScheme capec:capec_core ;
	capec:xsd_type "ReferencesType/Reference" .
capec:CapecReferenceId a rdfs:Datatype ;
	owl:equivalentClass _:c14n136 .
capec:CapecRelatedAttackPattern a owl:Class ;
	rdfs:label "CapecRelatedAttackPattern" ;
	rdfs:subClassOf capec:CapecExclusionsMixin , _:c14n110 , _:c14n195 , _:c14n27 , _:c14n341 , _:c14n75 , _:c14n95 ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/capec#RelatedAttackPattern> ;
	skos:definition "A relation from one attack pattern to another." ;
	skos:inScheme capec:capec_entries ;
	capec:xsd_type "RelatedAttackPatternType/Related_Attack_Pattern" .
capec:CapecRelatedNature\#CanAlsoBe a owl:Class ;
	rdfs:label "CanAlsoBe" ;
	rdfs:subClassOf capec:CapecRelatedNature ;
	skos:definition "In some settings this pattern can also be read as the other one, though not always the reverse." .
capec:CapecRelatedNature\#CanFollow a owl:Class ;
	rdfs:label "CanFollow" ;
	rdfs:subClassOf capec:CapecRelatedNature ;
	skos:definition "In a chain of attack, this pattern may come after the other." ;
	capec:inverse "CanPrecede" .
capec:CapecRelatedNature\#CanPrecede a owl:Class ;
	rdfs:label "CanPrecede" ;
	rdfs:subClassOf capec:CapecRelatedNature ;
	skos:definition "In a chain of attack, this pattern may come before the other." ;
	capec:inverse "CanFollow" .
capec:CapecRelatedNature\#ChildOf a owl:Class ;
	rdfs:label "ChildOf" ;
	rdfs:subClassOf capec:CapecRelatedNature ;
	skos:closeMatch skos:broader ;
	skos:definition "The other pattern is more abstract, and this one specialises it." ;
	capec:inverse "ParentOf" .
capec:CapecRelatedNature\#ParentOf a owl:Class ;
	rdfs:label "ParentOf" ;
	rdfs:subClassOf capec:CapecRelatedNature ;
	skos:closeMatch skos:narrower ;
	skos:definition "The other pattern is less abstract, and it specialises this one." ;
	capec:inverse "ChildOf" .
capec:CapecRelatedNature\#PeerOf a owl:Class ;
	rdfs:label "PeerOf" ;
	rdfs:subClassOf capec:CapecRelatedNature ;
	skos:definition "The two are alike in a way that no other nature covers." ;
	skos:relatedMatch skos:related .
capec:CapecRelatedNature a owl:Class ;
	rdfs:label "CapecRelatedNature" ;
	owl:unionOf _:c14n131 ;
	skos:definition "How one attack pattern relates to another." ;
	skos:inScheme capec:capec_entries ;
	skos:note "The natures come in pairs: ChildOf and ParentOf, CanFollow and CanPrecede. The XSD says CanAlsoBe need not hold in both directions and says nothing on whether PeerOf does. CAPEC 3.9 uses ChildOf and never ParentOf, and records no pair from both ends." ;
	linkml:permissible_values capec:CapecRelatedNature\#CanAlsoBe , capec:CapecRelatedNature\#CanFollow , capec:CapecRelatedNature\#CanPrecede , capec:CapecRelatedNature\#ChildOf , capec:CapecRelatedNature\#ParentOf , capec:CapecRelatedNature\#PeerOf ;
	capec:xsd_type "RelatedNatureEnumeration" .
capec:CapecRelatedWeakness a owl:Class ;
	rdfs:label "CapecRelatedWeakness" ;
